OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
OPENAI_API_KEY=
MAIN_MODEL=glm-5.3-flash
REASONING_EFFORT=max
# Includes provider thinking and visible output; use enough room for both.
MODEL_MAX_TOKENS=32768
MODEL_TIMEOUT=300
# Fast organizational triage; a bounded failure retains the full workflow.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.13.0
TYPESAFE_TIMEOUT=8
# Research and Tools R&D use Exa search and contents when this key is set.
# Keys remain server-side; no key is returned to the office UI.
EXA_API_KEY=
EXA_TIMEOUT=30
# Auto-select Exa with EXA_API_KEY, otherwise legacy Z.AI MCP.
# Optional explicit override: exa or zai_mcp. Exa failures never switch providers.
# WEB_SEARCH_PROVIDER=exa
# Optional separate provider connections. Keys never enter UI or run snapshots.
# ZAI_API_KEY also supplies legacy MCP auth; otherwise use a configured Z.AI endpoint's key.
# ZAI_API_KEY=
# ZAI_MODEL=glm-5.3-flash
# SPOC_OPENAI_API_KEY=
# SPOC_OPENAI_MODEL=gpt-5
# SPOC_COMPATIBLE_API_KEY=
# SPOC_COMPATIBLE_BASE_URL=
# SPOC_COMPATIBLE_MODEL=
DATABASE_URL=postgresql://spoc:spoc@127.0.0.1:5432/spoc
SPOC_DATA_DIR=.harness
SPOC_API_HOST=127.0.0.1
SPOC_API_PORT=8000
HARNESS_TEST_MODE=false
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=spoc-harness
